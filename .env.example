# Copy to .env. Only variables starting with VITE_ reach the browser, so never
# put a secret here.

# Where the dev server forwards /api requests (the backend).
VITE_API_PROXY_TARGET=http://localhost:3000

# true = answer /api calls with fake data from src/mocks (no backend needed) and
# turn on the demo extras: demo accounts on the sign-in page, a "Demo data"
# banner, a remembered session and the role switcher. Read at build time.
# `npm run dev:mock` switches this on for you, whatever this file says. For a
# Netlify demo set it in the site's environment variables, not in a file.
VITE_USE_MOCKS=false
